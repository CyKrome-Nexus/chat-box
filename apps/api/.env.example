# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to true behind Dokploy/Traefik so client IPs and HTTPS are detected correctly.
TRUST_PROXY=false

# Public URLs
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# Data stores
MONGODB_URI=mongodb://127.0.0.1:27017/chatbox
# Optional. Enables multi-instance Socket.IO, shared rate limits and presence.
REDIS_URL=

# Secrets — generate with: openssl rand -base64 48 / openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars-min
MESSAGE_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated emails that are granted the admin role on sign-in.
ADMIN_EMAILS=

# File storage: local (needs a persistent volume at UPLOAD_DIR) or s3 (S3, R2, MinIO…)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Email (password reset codes). Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Chatbox <no-reply@example.com>

# Expo push notifications (optional access token for enhanced security)
EXPO_ACCESS_TOKEN=

# Social sign-in
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=21600
