# Base URL of the Chatbox API (no trailing slash), e.g. https://api.chatbox.example.com
EXPO_PUBLIC_API_URL=http://localhost:4000
# Public web app URL used for shareable invite links
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Social sign-in (optional). The API must list the same client ids in GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_ID=
